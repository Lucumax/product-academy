---
import Base from "../../layouts/Base.astro";
import ProgressTransfer from "../../components/ProgressTransfer.astro";
import { paths } from "../../data/paths.json";
import { scenarioRouteForTarget, scenarioFileId } from "../../lib/simulator.js";
import { goDeeperSources } from "../../lib/journeySources.js";
import { sourceTag } from "../../lib/sourceLabels.js";

const scenarioModules = import.meta.glob("../../content/10_simulator/scenarios/*.md", {
  query: "?raw",
  import: "default",
  eager: true,
});
const scenarioIds = new Set(Object.keys(scenarioModules).map((f) => scenarioFileId(f)));

export async function getStaticPaths() {
  return paths.map((p) => ({ params: { id: p.id }, props: { p } }));
}
const { p } = Astro.props;

// Flatten steps to a linear list with stable keys for progress + prev/next.
const allSteps = [];
p.phases.forEach((ph, pi) =>
  ph.weeks.forEach((w, wi) =>
    w.steps.forEach((s, si) => {
      allSteps.push({
        ...s,
        key: `path:${p.id}:phase:${pi + 1}:week:${wi + 1}:step:${si + 1}`,
        weekTitle: w.title,
        phaseTitle: ph.title,
      });
    }),
  ),
);
const totalSteps = allSteps.length;
const pathKey = `path:${p.id}`;

// Go deeper: map each week's read targets to curated external sources.
const weekTargets = (week) => {
  const targets = week.steps.filter((s) => s.type === "read" && s.target).map((s) => s.target);
  if (targets.length === 0 && /\bAI\b/i.test(week.title || "")) return ["05_ai_product_management/"];
  return targets;
};
const weekDeepers = p.phases.map((phase) =>
  phase.weeks.map((week) => goDeeperSources(weekTargets(week))),
);
const phaseFraming = p.phases.map((phase, pi) => {
  let shown = false;
  return phase.weeks.map((week, wi) => {
    if (weekDeepers[pi][wi].length && !shown) {
      shown = true;
      return true;
    }
    return false;
  });
});

// Route simulator steps to the interactive simulator instead of plain docs.
const stepHref = (step) => {
  if (step.target && step.target.startsWith("10_simulator/")) {
    return scenarioRouteForTarget(step.target, scenarioIds);
  }
  if (step.route && step.route.includes("10_simulator")) return "/simulator/";
  return step.route;
};
---
<Base title={`${p.title} — Product Academy`} description={`Guided learning path: ${p.title}`} active="paths">
  <a href="/paths/" class="muted" style="font-size:14px">&larr; All journeys</a>
  <article class="doc-page journey">
    <div class="flex-between mb-2">
      <span class="chip">{p.title}</span>
      <span class="chip" id="progress-chip">{totalSteps} steps</span>
    </div>
    <div class="flex-between mb-2 pt-tools">
      <ProgressTransfer />
      <span class="pt-note muted" style="font-size:12px">Progress is saved on this device — export to move it between devices.</span>
    </div>
    <h1>{p.title}</h1>
    <p class="lede">
      Work through the phases in order. Check off each step as you go —
      your progress is saved on this device. Don't skip the practice.
    </p>

    <div class="journey-map" id="journey-map" data-path={p.id} data-total={totalSteps}>
      <div class="jm-bar"><div class="jm-bar-fill" id="jm-bar-fill"></div></div>
      <div class="jm-meta">
        <span class="chip" id="jm-count">0 / {totalSteps} complete</span>
        <span class="jm-pct" id="jm-pct">0%</span>
      </div>
      <div class="phase-stepper" id="phase-stepper">
        {p.phases.map((phase, pi) => (
          <button type="button" class="phase-node" data-phase={pi + 1} aria-label={`Jump to Phase ${pi + 1}`}>
            <span class="phase-dot" aria-hidden="true"></span>
            <span class="phase-label">Phase {pi + 1}</span>
          </button>
        ))}
      </div>
    </div>

    {p.phases.map((phase, pi) => (
      <section class="phase" data-phase={pi + 1}>
        <h2><span class="phase-num">Phase {pi + 1}</span> {phase.title}</h2>
        {phase.weeks.map((week, wi) => (
          <div class="week" data-week-key={`${pathKey}:phase:${pi + 1}:week:${wi + 1}:`}>
            <div class="week-head">
              <h3>Week {wi + 1}: {week.title}</h3>
              <span class="week-progress" title="Week completion">
                <span class="week-bar"><span class="week-bar-fill"></span></span>
                <span class="week-pct">0%</span>
              </span>
            </div>
            <ol class="steps">
              {week.steps.map((step, si) => {
                const key = `${pathKey}:phase:${pi + 1}:week:${wi + 1}:step:${si + 1}`;
                const href = stepHref(step);
                return (
                  <li class="step" data-key={key}>
                    <span class="step-check" aria-hidden="true">
                      <span class="step-checkbox"></span>
                    </span>
                    <div class="step-body">
                      <span class="step-label">{step.label}</span>
                      {href ? (
                        <a class="step-title" href={href}>{step.title}</a>
                      ) : (
                        <span class="step-title">{step.title}</span>
                      )}
                      {step.body && <div class="step-desc">{step.body}</div>}
                    </div>
                  </li>
                );
              })}
            </ol>
            <details class="selfcheck" data-path={p.id} data-phase={pi} data-week={wi}>
              <summary class="selfcheck-summary">
                <span class="selfcheck-title">Quick self-check</span>
                <span class="selfcheck-badge" hidden>Self-check done ✓</span>
              </summary>
              <div class="selfcheck-body">
                <p class="selfcheck-hint">
                  Three quick reflections on this week's material. Optional and non-blocking — your answers stay on this device.
                </p>
                {[
                  "In your own words, what is the core capability this week develops?",
                  "What's the one thing you'll apply this week?",
                  "What's still unclear?",
                ].map((q, qi) => (
                  <div class="selfcheck-q" data-q={qi}>
                    <label class="selfcheck-label">{q}</label>
                    <textarea class="selfcheck-text" data-q={qi} rows="2" placeholder="Write your reflection…"></textarea>
                    <div class="selfcheck-rate">
                      <span class="selfcheck-rate-hint">How solid is this for you?</span>
                      <button type="button" class="rate-btn" data-q={qi} data-rate="got">Got it</button>
                      <button type="button" class="rate-btn" data-q={qi} data-rate="partial">Partial</button>
                      <button type="button" class="rate-btn" data-q={qi} data-rate="notyet">Not yet</button>
                    </div>
                  </div>
                ))}
              </div>
            </details>
            {weekDeepers[pi][wi].length > 0 && (
              <details class="go-deeper">
                <summary class="go-deeper-summary">
                  <span class="go-deeper-title">Go deeper</span>
                  <span class="go-deeper-count">
                    {weekDeepers[pi][wi].length} external {weekDeepers[pi][wi].length === 1 ? "source" : "sources"}
                  </span>
                </summary>
                <div class="go-deeper-body">
                  {phaseFraming[pi][wi] && (
                    <p class="go-deeper-framing">
                      The Academy is the map. These are the deeper sources — follow them to go further.
                    </p>
                  )}
                  <ul class="go-deeper-list">
                    {weekDeepers[pi][wi].map((src) => (
                      <li>
                        <a class="go-deeper-link" href={src.url} target="_blank" rel="noreferrer">
                          <span class="gd-arrow" aria-hidden="true">↗</span>
                          <span class="gd-title">{src.title}</span>
                          <span class="gd-tag">{sourceTag(src.type)}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </details>
            )}
          </div>
        ))}
      </section>
    ))}

    <div class="journey-end">
      <p><strong>Path complete.</strong> Move to the next role's journey, or use the simulator to test your judgment.</p>
      <div class="end-links">
        <a class="jn-next-link" href="/simulator/">Simulator →</a>
        <a class="jn-next-link" href="/principles/">Core Doctrine →</a>
      </div>
    </div>
  </article>
</Base>

<style>
  .journey { max-width: 820px; }
  .phase { margin-top: 28px; }
  .phase-num {
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
    margin-right: 8px;
  }
  .week {
    background: var(--surface-2);
    border-radius: var(--radius);
    padding: 16px 20px;
    margin: 12px 0;
  }
  .week-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 12px;
  }
  .week-head h3 { margin: 0; font-size: 1rem; }
  .week-progress {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    flex: none;
  }
  .week-bar {
    width: 72px;
    height: 6px;
    background: rgb(0 0 0 / 0.08);
    border-radius: 999px;
    overflow: hidden;
  }
  .week-bar-fill {
    display: block;
    height: 100%;
    width: 0%;
    background: var(--accent);
    border-radius: 999px;
    transition: width 0.25s;
  }
  .week-pct {
    font-size: 11px;
    font-weight: 700;
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
    min-width: 30px;
    text-align: right;
  }
  .steps { list-style: none; margin: 0; padding: 0; }
  .step {
    display: flex;
    gap: 12px;
    padding: 8px 0;
    border-bottom: 1px solid var(--line);
    font-family: var(--font-sans);
  }
  .step:last-child { border-bottom: none; }
  .step-check { display: block; flex: none; }
  .step-checkbox {
    width: 18px; height: 18px;
    border: 2px solid var(--ink-3);
    border-radius: 50%;
    display: block;
    margin-top: 3px;
    cursor: pointer;
    transition: background 0.15s, border-color 0.15s;
  }
  .step.done .step-checkbox {
    background: #34d399;
    border-color: #34d399;
  }
  .step-body { flex: 1; min-width: 0; }
  .step-label {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-3);
    margin-bottom: 2px;
  }
  .step-title { font-size: 14px; color: var(--ink); text-decoration: none; }
  .step-title:hover { text-decoration: underline; }
  .step-desc { font-size: 12px; color: var(--ink-2); margin-top: 3px; }
  .journey-end { margin-top: 32px; padding-top: 20px; border-top: 1px solid var(--line); }
  .end-links { display: flex; gap: 12px; margin-top: 10px; flex-wrap: wrap; }
  .jn-next-link {
    background: var(--accent);
    color: #fff;
    text-decoration: none;
    padding: 10px 18px;
    border-radius: 999px;
    font-weight: 600;
    font-size: 14px;
  }

  /* ----------------------------------------------------------- progress map */
  .journey-map {
    background: var(--surface-2);
    border-radius: var(--radius);
    padding: 16px 18px 14px;
    margin: 8px 0 20px;
  }
  .jm-bar {
    height: 8px;
    background: rgb(0 0 0 / 0.08);
    border-radius: 999px;
    overflow: hidden;
  }
  .jm-bar-fill {
    display: block;
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, var(--accent), #d97706);
    border-radius: 999px;
    transition: width 0.3s;
  }
  .jm-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 8px;
  }
  .jm-meta .chip { margin-right: 0; }
  .jm-pct {
    font-size: 13px;
    font-weight: 700;
    color: var(--accent-ink);
    font-variant-numeric: tabular-nums;
  }
  .phase-stepper {
    display: flex;
    align-items: flex-start;
    gap: 4px;
    margin-top: 14px;
  }
  .phase-node {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    background: none;
    border: none;
    padding: 4px 2px;
    cursor: pointer;
    position: relative;
    color: var(--ink-3);
    font-family: var(--font-sans);
    font-size: 12px;
  }
  .phase-node::before {
    content: "";
    position: absolute;
    top: 15px;
    left: -52%;
    width: 100%;
    height: 3px;
    background: var(--line);
  }
  .phase-node:first-child::before { display: none; }
  .phase-dot {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    border: 3px solid var(--line);
    background: var(--surface);
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    transition: background 0.2s, border-color 0.2s, box-shadow 0.2s;
  }
  .phase-node.complete .phase-dot {
    background: var(--accent);
    border-color: var(--accent);
  }
  .phase-node.complete .phase-dot::after {
    content: "✓";
    color: #fff;
    font-size: 12px;
    font-weight: 700;
  }
  .phase-node.current .phase-dot {
    border-color: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-soft);
  }
  .phase-node.current .phase-label { color: var(--accent-ink); font-weight: 700; }
  .phase-node.complete .phase-label { color: var(--ink-2); }

  /* ------------------------------------------------------------- self-check */
  .selfcheck {
    margin-top: 14px;
    border: 1px dashed #d9d2c4;
    border-radius: var(--radius-sm);
    background: var(--surface);
  }
  .selfcheck-summary {
    display: flex;
    align-items: center;
    gap: 10px;
    cursor: pointer;
    padding: 10px 14px;
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 600;
    color: var(--ink-2);
    list-style: none;
  }
  .selfcheck-summary::-webkit-details-marker { display: none; }
  .selfcheck-summary::before {
    content: "▸";
    color: var(--accent);
    transition: transform 0.15s;
  }
  .selfcheck[open] .selfcheck-summary::before { transform: rotate(90deg); }
  .selfcheck-badge {
    margin-left: auto;
    font-size: 11px;
    font-weight: 700;
    color: #065f46;
    background: #d1fae5;
    padding: 2px 8px;
    border-radius: 999px;
  }
  .selfcheck-body { padding: 0 14px 14px; font-family: var(--font-sans); }
  .selfcheck-hint {
    font-size: 12px;
    color: var(--ink-3);
    margin: 4px 0 12px;
  }
  .selfcheck-q {
    border-top: 1px solid var(--line);
    padding: 12px 0;
  }
  .selfcheck-label {
    display: block;
    font-size: 13px;
    font-weight: 600;
    color: var(--ink);
    margin-bottom: 6px;
  }
  .selfcheck-text {
    width: 100%;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface);
    padding: 8px 10px;
    font-family: var(--font-sans);
    font-size: 13px;
    color: var(--ink);
    resize: vertical;
  }
  .selfcheck-text:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }
  .selfcheck-rate {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 8px;
    flex-wrap: wrap;
  }
  .selfcheck-rate-hint {
    font-size: 11px;
    color: var(--ink-3);
    margin-right: 2px;
  }
  .rate-btn {
    border: 1px solid var(--line);
    background: var(--surface);
    border-radius: 999px;
    padding: 3px 10px;
    font-size: 11px;
    font-weight: 600;
    color: var(--ink-2);
    cursor: pointer;
    transition: background 0.15s, border-color 0.15s, color 0.15s;
  }
  .rate-btn:hover { border-color: var(--accent); color: var(--accent-ink); }
  .rate-btn.active {
    border-color: var(--accent);
    background: var(--accent-soft);
    color: var(--accent-ink);
  }
  .rate-btn[data-rate="got"].active { border-color: #34d399; background: #ecfdf5; color: #065f46; }
  .rate-btn[data-rate="notyet"].active { border-color: #fca5a5; background: #fef2f2; color: #991b1b; }

  /* ----------------------------------------------------------- go deeper */
  .go-deeper {
    margin-top: 14px;
    border: 1px dashed var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface);
  }
  .go-deeper-summary {
    display: flex;
    align-items: center;
    gap: 10px;
    cursor: pointer;
    padding: 9px 14px;
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 600;
    color: var(--ink-3);
    list-style: none;
  }
  .go-deeper-summary::-webkit-details-marker { display: none; }
  .go-deeper-summary::before {
    content: "▸";
    color: var(--accent);
    transition: transform 0.15s;
  }
  .go-deeper[open] .go-deeper-summary::before { transform: rotate(90deg); }
  .go-deeper-count {
    margin-left: auto;
    font-size: 11px;
    font-weight: 600;
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }
  .go-deeper-body { padding: 0 14px 12px; }
  .go-deeper-framing {
    font-size: 12px;
    color: var(--ink-3);
    font-family: var(--font-sans);
    font-style: italic;
    margin: 2px 0 10px;
  }
  .go-deeper-list { list-style: none; margin: 0; padding: 0; }
  .go-deeper-list li { border-top: 1px solid var(--line); padding: 7px 0; }
  .go-deeper-list li:first-child { border-top: none; }
  .go-deeper-link {
    display: flex;
    align-items: baseline;
    gap: 8px;
    text-decoration: none;
    font-family: var(--font-sans);
    font-size: 13px;
  }
  .gd-arrow { color: var(--accent); flex: none; }
  .gd-title { color: var(--ink); }
  .go-deeper-link:hover .gd-title { text-decoration: underline; }
  .gd-tag {
    margin-left: auto;
    flex: none;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--ink-3);
    background: var(--surface-2);
    border-radius: 999px;
    padding: 1px 8px;
  }

  .pt-tools { align-items: center; }
</style>

<script>
  // Hydrate checkboxes + progress map from localStorage.
  const map = document.getElementById("journey-map");
  const pathId = map ? map.dataset.path : "";
  const total = map ? parseInt(map.dataset.total, 10) : 0;
  const PATH_KEY = "pa-progress-v1";
  const pathPrefix = `path:${pathId}`;

  function load() { try { return JSON.parse(localStorage.getItem(PATH_KEY) || "{}"); } catch { return {}; } }
  function save(s) { try { localStorage.setItem(PATH_KEY, JSON.stringify(s)); } catch {} }

  function doneSet() {
    const d = load().done || {};
    return new Set(Object.keys(d).filter((k) => k.startsWith(pathPrefix)));
  }

  function refreshOverall(done) {
    const n = done.size;
    const p = total ? Math.round((n / total) * 100) : 0;
    const count = document.getElementById("jm-count");
    const chip = document.getElementById("progress-chip");
    const fill = document.getElementById("jm-bar-fill");
    const pct = document.getElementById("jm-pct");
    if (chip) chip.textContent = `${n} / ${total} steps complete`;
    if (count) count.textContent = `${n} / ${total} complete`;
    if (fill) fill.style.width = p + "%";
    if (pct) pct.textContent = p + "%";
  }

  function refreshStepper(done) {
    const sections = Array.from(document.querySelectorAll(".phase[data-phase]"));
    let current = 1;
    let found = false;
    sections.forEach((sec) => {
      const pi = Number(sec.dataset.phase);
      const keys = Array.from(sec.querySelectorAll(".step[data-key]")).map((el) => el.dataset.key);
      const doneCount = keys.filter((k) => done.has(k)).length;
      const complete = keys.length > 0 && doneCount === keys.length;
      const node = document.querySelector(`.phase-node[data-phase="${pi}"]`);
      if (node) node.classList.toggle("complete", complete);
      if (!found && !complete) { current = pi; found = true; }
    });
    if (!found && sections.length) current = Number(sections[sections.length - 1].dataset.phase);
    document.querySelectorAll(".phase-node[data-phase]").forEach((node) => {
      node.classList.toggle("current", Number(node.dataset.phase) === current);
    });
  }

  function refreshWeeks(done) {
    document.querySelectorAll(".week[data-week-key]").forEach((week) => {
      const prefix = week.dataset.weekKey;
      const totalInWeek = week.querySelectorAll(".step[data-key]").length;
      const doneCount = [...done].filter((k) => k.startsWith(prefix)).length;
      const p = totalInWeek ? Math.round((doneCount / totalInWeek) * 100) : 0;
      const fillEl = week.querySelector(".week-bar-fill");
      const pctEl = week.querySelector(".week-pct");
      if (fillEl) fillEl.style.width = p + "%";
      if (pctEl) pctEl.textContent = p + "%";
    });
  }

  function refreshAll() {
    const done = doneSet();
    refreshOverall(done);
    refreshStepper(done);
    refreshWeeks(done);
  }

  // Phase stepper → jump to that phase.
  document.querySelectorAll(".phase-node[data-phase]").forEach((node) => {
    node.addEventListener("click", () => {
      const sec = document.querySelector(`.phase[data-phase="${node.dataset.phase}"]`);
      if (sec) sec.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  });

  // Step checkboxes.
  document.querySelectorAll(".step").forEach((el) => {
    const key = el.dataset.key;
    const s = load();
    if (s.done && s.done[key]) el.classList.add("done");
    el.querySelector(".step-checkbox").addEventListener("click", () => {
      const st = load();
      st.done = st.done || {};
      if (st.done[key]) { delete st.done[key]; el.classList.remove("done"); }
      else { st.done[key] = true; el.classList.add("done"); }
      save(st);
      refreshAll();
    });
  });
  refreshAll();
</script>

<script>
  // Quick self-checks: per-week reflection answers + optional ratings.
  /** @param {HTMLElement} el */
  const scKey = (el) =>
    `pa-selfcheck-${el.dataset.path}-${el.dataset.phase}-${el.dataset.week}`;

  function scLoad(key) {
    try { return JSON.parse(localStorage.getItem(key) || "{}"); } catch { return {}; }
  }
  function scSave(key, state) {
    try { localStorage.setItem(key, JSON.stringify(state)); } catch {}
  }

  /** @param {{ q?: (string|null)[] }} state */
  function scEmpty(state, i) {
    const q = state.q && state.q[i];
    return !q || !q.trim();
  }
  /** @param {HTMLElement} el @param {{ q?: (string|null)[] }} state */
  function scRefreshBadge(el, state) {
    const badge = /** @type {HTMLElement | null} */ (el.querySelector(".selfcheck-badge"));
    const done = [0, 1, 2].every((i) => !scEmpty(state, i));
    if (badge) badge.hidden = !done;
  }

  document.querySelectorAll<HTMLElement>(".selfcheck[data-path]").forEach((el) => {
    const key = scKey(el);
    const state = { q: ["", "", ""], r: [null, null, null], ...scLoad(key) };
    if (!Array.isArray(state.q)) state.q = ["", "", ""];
    if (!Array.isArray(state.r)) state.r = [null, null, null];

    el.querySelectorAll<HTMLTextAreaElement>(".selfcheck-text").forEach((ta) => {
      const i = Number(ta.dataset.q);
      ta.value = state.q[i] || "";
      ta.addEventListener("input", () => {
        state.q[i] = ta.value;
        state.updatedAt = Date.now();
        scSave(key, state);
        scRefreshBadge(el, state);
      });
    });

    el.querySelectorAll<HTMLButtonElement>(".rate-btn").forEach((btn) => {
      const i = Number(btn.dataset.q);
      btn.classList.toggle("active", state.r[i] === btn.dataset.rate);
      btn.addEventListener("click", () => {
        const next = state.r[i] === btn.dataset.rate ? null : btn.dataset.rate;
        state.r[i] = next;
        state.updatedAt = Date.now();
        scSave(key, state);
        el.querySelectorAll<HTMLButtonElement>(`.rate-btn[data-q="${i}"]`).forEach((b) => {
          b.classList.toggle("active", b.dataset.rate === next);
        });
      });
    });

    scRefreshBadge(el, state);
  });

  window.addEventListener("pa:progress-imported", () => location.reload());
</script>
