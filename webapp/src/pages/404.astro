---
import Base from "../layouts/Base.astro";
const b = (p) => (import.meta.env.BASE_URL || "/") + p.replace(/^\//, "");
---
<Base title="Page not found — Product Academy" description="The page you were looking for does not exist." noindex>
  <section style="padding: 4rem 0; text-align: center;">
    <h1>404 — page not found</h1>
    <p class="muted">The page you are looking for does not exist or has moved.</p>
    <p><a href={b("/")}>Go to the start page</a> · <a href={b("/skills/")}>Browse the skills</a></p>
  </section>
</Base>
