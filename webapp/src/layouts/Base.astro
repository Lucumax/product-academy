---
// Base layout: top nav + content area.
interface Props {
  title?: string;
  description?: string;
  active?: string;
}
const { title = "Product Academy", description = "", active = "" } = Astro.props;
const nav = [
  { href: "/", label: "Start", id: "home" },
  { href: "/paths/", label: "Journeys", id: "paths" },
  { href: "/principles/", label: "Doctrine", id: "principles" },
  { href: "/simulator/", label: "Simulator", id: "simulator" },
  { href: "/cases/", label: "Cases", id: "cases" },
  { href: "/sources/", label: "Sources", id: "sources" },
];
import "../styles/global.css";
import Search from "../components/Search.astro";
import ContinueLearning from "../components/ContinueLearning.astro";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&family=JetBrains+Mono:wght@400;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="/">
          <span class="brand-mark">PA</span>
          <span class="brand-name">Product Academy</span>
        </a>
        <nav class="main-nav" aria-label="Primary">
          {nav.map((item) => (
            <a
              href={item.href}
              class:list={["nav-link", { active: active === item.id }]}
            >{item.label}</a>
          ))}
          <Search />
        </nav>
      </div>
    </header>
    <main class="site-main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-inner">
        <p>
          Product Academy — an evidence-backed product leadership curriculum.
          Content from the Product Leadership Academy.
        </p>
        <p class="footer-notes">
          Claims carry epistemic labels: [E] evidence · [P] practitioner · [I] inference · [D] debate · [R] recommendation
        </p>
      </div>
    </footer>
    <ContinueLearning />
  </body>
</html>
