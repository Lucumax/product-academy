---
// Base layout: top nav + content area.
interface Props {
  title?: string;
  description?: string;
  active?: string;
  noindex?: boolean;
  ogImage?: string;
}
const { title = "Product Academy", description = "", active = "", noindex = false } = Astro.props;
const origin = "https://lucumax.github.io";
const base = Astro.base || "/";
const canonical = new URL(Astro.url.pathname, origin).href;
const b = (path) => base + path.replace(/^\//, "");
const ogImage = Astro.props.ogImage ?? `${origin}${base}og-skills.png`;
const ogTitle = title.includes("Product Academy") ? title : `${title} | Product Academy`;
const nav = [
  { href: "/", label: "Start", id: "home" },
  { href: "/skills/", label: "Skills", id: "skills" },
  { href: "/paths/", label: "Journeys", id: "paths" },
  { href: "/principles/", label: "Doctrine", id: "principles" },
  { href: "/simulator/", label: "Simulator", id: "simulator" },
  { href: "/cases/", label: "Cases", id: "cases" },
  { href: "/sources/", label: "Sources", id: "sources" },
];
import "../styles/global.css";
import Search from "../components/Search.astro";
import ContinueLearning from "../components/ContinueLearning.astro";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{ogTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex ? <meta name="robots" content="noindex" /> : null}
    <link rel="icon" type="image/svg+xml" href={`${origin}${base}favicon.svg`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Product Academy" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&family=JetBrains+Mono:wght@400;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href={b("/")}>
          <span class="brand-mark">PA</span>
          <span class="brand-name">Product Academy</span>
        </a>
        <nav class="main-nav" aria-label="Primary">
          {nav.map((item) => (
            <a
              href={b(item.href)}
              class:list={["nav-link", { active: active === item.id }]}
            >{item.label}</a>
          ))}
          <Search />
        </nav>
      </div>
    </header>
    <main class="site-main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-inner">
        <p>
          Product Academy — an evidence-backed product leadership curriculum with
          <a href={b("/skills/")}> product management skills for AI agents</a>.
          Content from the Product Leadership Academy.
        </p>
        <p class="footer-notes">
          Claims carry epistemic labels: [E] evidence · [P] practitioner · [I] inference · [D] debate · [R] recommendation
        </p>
      </div>
    </footer>
    <ContinueLearning />
  </body>
</html>
