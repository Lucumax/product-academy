---
// RelatedRail: a compact horizontal "Related" section with type chips.
// Renders an optional "Next in journey" hint followed by horizontal-scroll
// rows of small cards, each linking to its own page.
interface RelatedItem {
  id: string;
  title: string;
  href: string;
  type: string;
}
interface RelatedGroup {
  key: string;
  title: string;
  kind: string;
  items: RelatedItem[];
}
interface Props {
  groups?: RelatedGroup[];
  next?: { url: string; label: string; journey?: string } | null;
}
const { groups = [], next = null } = Astro.props;
const visible = groups.filter((g) => g.items && g.items.length);
const hasAny = (next !== null && next !== undefined) || visible.length > 0;
---
{hasAny && (
  <section class="related-rail">
    <h2>Related</h2>

    {next && (
      <a class="rel-next" href={next.url}>
        <span class="rel-next-kicker">
          {next.journey ? `Next in this journey · ${next.journey}` : "Next in this journey"}
        </span>
        <span class="rel-next-label">{next.label} →</span>
      </a>
    )}

    {visible.map((g) => (
      <div class="rel-group">
        <h3 class="rel-group-title">{g.title}</h3>
        <div class="rel-scroll">
          {g.items.map((it) => (
            <a class="rel-card" href={it.href}>
              <span class={`rel-chip rel-chip-${it.type.toLowerCase()}`}>{it.type}</span>
              <span class="rel-id">{it.id}</span>
              <span class="rel-title">{it.title}</span>
            </a>
          ))}
        </div>
      </div>
    ))}
  </section>
)}

<style>
  .related-rail {
    margin-top: 36px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }
  .related-rail h2 { margin-top: 0; }
  .rel-next {
    display: flex;
    flex-direction: column;
    gap: 2px;
    text-decoration: none;
    background: var(--accent-soft);
    border: 1px solid #f2ddc0;
    border-radius: var(--radius);
    padding: 12px 16px;
    margin-bottom: 20px;
    transition: border-color 0.15s, transform 0.12s;
  }
  .rel-next:hover {
    border-color: var(--accent);
    transform: translateY(-1px);
  }
  .rel-next-kicker {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent-ink);
    font-weight: 600;
  }
  .rel-next-label {
    font-size: 14px;
    font-weight: 600;
    color: var(--ink);
  }
  .rel-group { margin-bottom: 18px; }
  .rel-group-title {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-3);
    margin: 0 0 10px;
    font-weight: 600;
  }
  .rel-scroll {
    display: flex;
    gap: 10px;
    overflow-x: auto;
    padding-bottom: 8px;
    scrollbar-width: thin;
  }
  .rel-card {
    flex: 0 0 auto;
    width: 210px;
    max-width: 70vw;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    padding: 10px 12px;
    text-decoration: none;
    color: var(--ink);
    display: flex;
    flex-direction: column;
    gap: 3px;
    box-shadow: var(--shadow);
    transition: transform 0.12s, border-color 0.12s;
  }
  .rel-card:hover {
    transform: translateY(-2px);
    border-color: #d9d2c4;
  }
  .rel-id {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--ink-3);
  }
  .rel-title {
    font-size: 13px;
    line-height: 1.35;
    color: var(--ink);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .rel-chip {
    align-self: flex-start;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 1px 7px;
    border-radius: 999px;
    background: var(--surface-2);
    color: var(--ink-3);
  }
  .rel-chip-principle { background: #dbeafe; color: #1e3a8a; }
  .rel-chip-tension { background: #fee2e2; color: #7f1d1d; }
  .rel-chip-case { background: #dcfce7; color: #14532d; }
  .rel-chip-source { background: var(--accent-soft); color: var(--accent-ink); }
</style>
